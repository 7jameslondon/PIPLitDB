{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pip-litdb.org/schema/paper.schema.json",
  "title": "PIP LitDB publication record",
  "description": "Metadata for one scholarly work. The PIP LitDB ID is the five-digit YAML filename and is intentionally not stored in the record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "publication_stage",
    "title",
    "authors",
    "doi",
    "publication_year",
    "journal",
    "language_status",
    "pip_litdb_file_status"
  ],
  "properties": {
    "document_type": {
      "type": "string",
      "minLength": 1,
      "description": "A value defined in database/vocabularies/document-types.yaml."
    },
    "publication_stage": {
      "type": "string",
      "minLength": 1,
      "description": "A value defined in database/vocabularies/publication-stages.yaml."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "doi": {
      "type": "string",
      "minLength": 1,
      "pattern": "^10\\.[0-9]{4,9}/\\S+$",
      "description": "A DOI without a https://doi.org/ prefix."
    },
    "publication_year": {
      "type": "integer",
      "minimum": 1800
    },
    "journal": {
      "type": "string",
      "minLength": 1,
      "description": "The full journal name, book series or publisher, or preprint server name."
    },
    "language_status": {
      "type": "string",
      "minLength": 1,
      "description": "A value defined in database/vocabularies/language-statuses.yaml."
    },
    "pip_litdb_file_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_pdf",
        "supplementary_material",
        "full_text_html"
      ],
      "properties": {
        "main_pdf": {
          "$ref": "#/$defs/fileStatus"
        },
        "supplementary_material": {
          "$ref": "#/$defs/fileStatus"
        },
        "full_text_html": {
          "$ref": "#/$defs/fileStatus"
        }
      },
      "description": "Publicly committed statuses for source materials in the PIP LitDB project's private holdings."
    },
    "related_papers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relatedPaper"
      }
    },
    "pip_litdb_status": {
      "type": "string",
      "minLength": 1,
      "description": "A value defined in database/vocabularies/record-statuses.yaml."
    },
    "pip_litdb_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "fileStatus": {
      "type": "string",
      "minLength": 1,
      "description": "A value defined in database/vocabularies/file-statuses.yaml."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1,
          "description": "An optional project-wide canonical form of the author name; omit when identical to name."
        }
      }
    },
    "relatedPaper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pip_litdb_id",
        "relationship_type"
      ],
      "properties": {
        "pip_litdb_id": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1,
          "description": "A value defined in database/vocabularies/relationship-types.yaml."
        }
      }
    }
  }
}
