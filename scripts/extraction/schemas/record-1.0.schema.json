{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pip-litdb.org/schema/record-1.0.schema.json",
  "title": "PIP LitDB canonical extracted record",
  "description": "Content-only, machine-ready extraction. Source provenance, confidence, repairs, and review evidence belong in extraction_diagnostic, not in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_path_base",
    "content_format",
    "record",
    "front_matter",
    "sections",
    "figures",
    "tables",
    "supporting_information",
    "supplements",
    "references",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_path_base": {
      "const": "extraction_root",
      "description": "Every path in this document is relative to the directory containing record.json."
    },
    "content_format": {
      "const": "safe-html",
      "description": "Rich content contains deterministic, sanitized HTML fragments generated by the extractor. Source text is escaped and only minimal semantic formatting is retained. A viewer must still sanitize before insertion."
    },
    "record": {
      "$ref": "#/$defs/recordMetadata"
    },
    "front_matter": {
      "$ref": "#/$defs/blocks"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "supporting_information": {
      "$ref": "#/$defs/blocks"
    },
    "supplements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplement"
      }
    },
    "references": {
      "$ref": "#/$defs/blocks"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "recordMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "authors",
        "journal",
        "publication_year",
        "doi",
        "document_type",
        "bibliographic"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": "string"
        },
        "publication_year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "doi": {
          "type": "string"
        },
        "document_type": {
          "type": "string"
        },
        "bibliographic": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plain_text",
        "html"
      ],
      "properties": {
        "plain_text": {
          "type": "string"
        },
        "html": {
          "type": "string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind",
        "content"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/richText"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "heading",
        "level",
        "blocks"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/richText"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "label",
        "kind",
        "caption"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "$ref": "#/$defs/richText"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "label",
        "title",
        "parts",
        "footnotes",
        "footnotes_typed",
        "structure_assets",
        "machine_records",
        "source_kind"
      ],
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/richText"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tablePart"
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richText"
          }
        },
        "footnotes_typed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedFootnote"
          }
        },
        "structure_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/assetPath"
          }
        },
        "machine_records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "html",
            "pdf",
            "image"
          ]
        },
        "source_image": {
          "$ref": "#/$defs/assetPath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "html"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "source_image"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "pdf",
                  "image"
                ]
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "required": [
              "source_image"
            ]
          }
        }
      ]
    },
    "tablePart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "rows"
      ],
      "properties": {
        "part_id": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tableCell"
            }
          }
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "html",
        "header",
        "rowspan",
        "colspan"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "header": {
          "type": "boolean"
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "typedFootnote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "scope",
        "text"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_id",
        "file",
        "blocks",
        "figures",
        "tables",
        "asset_ids"
      ],
      "properties": {
        "supplement_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "media_type"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/assetPath"
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Generic supplement media and data assets not otherwise represented as a figure or table."
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "label",
        "path",
        "media_type"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/assetPath"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "description": "A portable relative file path resolved from the extraction root. URLs, data URIs, absolute paths, backslashes, and traversal are forbidden."
    }
  }
}
